[Desktop Entry]
Name=VellorGram Desktop
Comment=Desktop version of VellorGram - ToS breaking Telegram client
TryExec=VellorGram
Exec=env DESKTOPINTEGRATION=1 VellorGram -- %U
Icon=com.vellorgram.desktop
Terminal=false
StartupWMClass=VellorGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=VellorGram -quit
Name=Quit VellorGram
Icon=application-exit
